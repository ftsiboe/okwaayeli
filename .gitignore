.Rproj.user
.Rhistory
.RData
.Ruserdata
.DS_Store
.Renviron
# Per-study agent prompts: working notes for the next session on that study,
# not part of the published repo.
studies/**/AGENT_PROMPT.md
studies/**/_to_delete/
studies/**/assets/
studies/**/logs/
# Diagnostic harness: a scratch file for dissecting one specification. Neither a
# numbered step nor a library, so it does not belong in scripts/ permanently.
studies/**/surgery.R
# Study outputs (large; download from GitHub release instead).
studies/**/*.dta
studies/**/*.rds
studies/**/*.zip
studies/**/*.csv
studies/**/*.xlsx
studies/**/*.png
*.log
# !studies/**/narrative/resource-extraction.html
# Package data slot kept lean.
data/*
# data-raw/ is private by default, but we track the documentation and
# scripts that live alongside the harmonized release.
data-raw/*
!data-raw/scripts/
!data-raw/releases/
data-raw/releases/*
!data-raw/releases/harmonized_data/
data-raw/releases/harmonized_data/*
!data-raw/releases/harmonized_data/README.md
!data-raw/releases/harmonized_data/README.Rmd
!data-raw/releases/harmonized_data/codebook.md
# The ag services release is tracked, unlike its siblings. Three reasons:
#   - it is 89 KB, against 1.9-35 MB for the others, so it costs nothing
#   - studies/ag_services/scripts/001 reads it LOCALLY rather than via
#     get_household_data(), because the published copy at
#     ftsiboe/GHAgricProductivityLab@hh_data is not the build this study uses
#   - tracking it means the build travels with the code that produced it, so
#     an HPC node or a co-author's clone gets the right data from `git pull`
!data-raw/releases/harmonized_data/harmonized_ag_services_data.dta
# Test fixtures (downloaded on demand).
tests/**/*.dta
tests/**/*.rds
tests/**/*.zip
tests/**/*.csv
tests/**/*.xlsx
tests/**/*.png
# Office lock files.
~$*
*.tmp
# Windows Explorer folder-settings files (regenerated locally; never part of the repo).
desktop.ini
studies/**/desktop.ini
# pkgdown / R build artifacts.
docs/
inst/doc/
*.Rcheck/
*.tar.gz
replications

# Harmonization run logs are local artefacts, not part of the repo.
data-raw/scripts/data-prep/glss/logs/
